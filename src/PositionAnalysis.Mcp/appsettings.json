{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "SchedulePCMcp": "Debug"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "standardErrorFromLevel": "Verbose"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs\\schedulepcmcp-.log",
          "rollingInterval": "Day",
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [PID {ProcessId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithProperty", "WithProcessId" ],
    "Properties": {
      "Application": "SchedulePCMcp"
    }
  },
  "Oracle": {
    "ConnectionName": "",
    "ConnectionString": "",
    "CommandTimeout": 300
  },
  "AiProvider": {
    "Type": "AzureOpenAI",
    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "Model": "gemma4:latest",
      "NumCtx": 32768,
      "Temperature": 0.7
    },
    "AzureOpenAI": {
      "Endpoint": "https://devops-cicd.openai.azure.us/",
      "ApiKey": "{api-key}",
      "DeploymentName": "gpt-5.1",
      "MaxCompletionTokens": 16384,
      "Temperature": 0.2
    }
  },
  "Storage": {
    "Provider": "FileSystem",
    "FileSystem": {
      "ReportsBaseDirectory": "../../../reports/schedule-pc"
    },
    "Database": {
      "BlobTableName": "SCHEDULE_PC_ARTIFACTS",
      "MetadataTableName": "SCHEDULE_PC_ARTIFACTS_METADATA"
    }
  },
  "DocumentGeneration": {
    "Strategy": "OpenXml",
    "TemplateFile": "templates\\Schedule_PC_Position_Evaluation_Template_Updated.docx",
    "OutputPath": "reports\\schedule-pc"
  },
  "ExcelExport": {
    "Implementation": "ClosedXML",
    "OutputPath": "reports\\schedule-pc"
  },
  "MCP": {
    "EnableDevLogging": true,
    "EnableMetrics": true
  },
  "Features": {
    "AsyncScoring": true,
    "InMemoryStatusCache": true,
    "PersistStatusToDB": true
  }
}
