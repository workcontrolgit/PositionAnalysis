{
  "AI": {
    "Provider": "AzureOpenAI",
    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "Model": "gemma4:latest",
      "NumCtx": 12288
    },
    "AzureOpenAI": {
      "Endpoint": "https://devops-cicd.openai.azure.us/",
      "DeploymentName": "gpt-5.1",
      "ApiKey": ""
    },
    "Claude": {
      "Endpoint": "https://your-resource.services.ai.azure.com/anthropic/v1/messages",
      "DeploymentName": "claude-opus-4-6",
      "ApiKey": ""
    }
  },
  "SqlclMcp": {
    "Path": "C:\\Users\\NguyenFD\\.vscode\\extensions\\oracle.sql-developer-26.2.1-win32-x64\\dbtools\\sqlcl\\bin\\sql.exe",
    "ConnectionName": "ACRS",
    "MaxDisplayRows": 50
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Warning"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs\\schedulepc-.log",
          "rollingInterval": "Day",
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [PID {ProcessId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithProcessId" ],
    "Properties": {
      "Application": "SchedulePC"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
