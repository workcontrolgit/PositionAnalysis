{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "SchedulePCMcp": "Debug"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "standardErrorFromLevel": "Verbose"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\apps\\schedulepc\\logs\\spc-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithProperty" ],
    "Properties": {
      "Application": "SchedulePCMcp"
    }
  },
  "Oracle": {
    "ConnectionString": "Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=localhost)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=XEPDB1)));User Id=hr;Password=HrUser_2026;",
    "CommandTimeout": 300
  },
  "AiProvider": {
    "Type": "Ollama",
    "Model": "neural-chat:latest",
    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "Temperature": 0.7
    },
    "AzureOpenAI": {
      "Endpoint": "https://{resource}.openai.azure.com/",
      "ApiKey": "{api-key}",
      "DeploymentName": "gpt-4",
      "Temperature": 0.7
    }
  },
  "Storage": {
    "Provider": "FileSystem",
    "FileSystem": {
      "ReportsBaseDirectory": "C:\\apps\\schedulepc\\reports"
    },
    "Database": {
      "BlobTableName": "SCHEDULE_PC_ARTIFACTS",
      "MetadataTableName": "SCHEDULE_PC_ARTIFACTS_METADATA"
    }
  },
  "DocumentGeneration": {
    "Strategy": "OpenXml",
    "TemplateFile": "C:\\apps\\oracle\\src\\SchedulePCMcp\\templates\\Schedule_PC_Position_Evaluation_Template_Updated.docx",
    "OutputPath": "C:\\apps\\schedulepc\\reports"
  },
  "ExcelExport": {
    "Implementation": "ClosedXML",
    "OutputPath": "C:\\apps\\schedulepc\\reports"
  },
  "MCP": {
    "EnableDevLogging": true,
    "EnableMetrics": true
  },
  "Features": {
    "AsyncScoring": true,
    "InMemoryStatusCache": true,
    "PersistStatusToDB": true
  }
}
